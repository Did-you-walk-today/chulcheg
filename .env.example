# ── 학교 IP 접속 제어 ──────────────────────────────────────────────
# 학교 와이파이의 공인 IP 대역(들)을 쉼표로 구분해 넣는다. CIDR 지원.
# 학교 IP 범위 "전체"를 승인하는 것이 정책이므로, 학교가 보유한 모든
# 공인 대역을 여기에 넣는다. (캠퍼스/건물별로 여러 개면 전부 나열)
#
# 예) ALLOWED_IPS=203.0.113.0/24,198.51.100.0/24,2001:db8::/32
#
# ※ 비워두면(또는 미설정) IP 검사를 하지 않고 전부 통과한다(개발 모드).
#   내일 학교에서 실제 대역을 받으면 여기에 채워 넣으면 자동으로 enforce 된다.
ALLOWED_IPS=

# IP 검사를 강제로 끄고 싶을 때 true. (로컬 개발/디버깅용)
IP_CHECK_DISABLED=true

# ── 세션 ───────────────────────────────────────────────────────────
# 세션 쿠키 서명용 비밀키. 운영에선 반드시 길고 무작위한 값으로 교체.
SESSION_SECRET=dev-only-change-me-please-0123456789abcdef

# ── DB (로컬 개발) ─────────────────────────────────────────────────
# 로컬 SQLite 파일 경로. (Cloudflare 배포 시엔 D1 바인딩으로 대체)
LOCAL_DB_PATH=./local.db
