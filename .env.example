# Cloudflare 배포에서는 환경변수를 wrangler.jsonc(vars) 와 secret 으로 관리한다.
# 이 파일은 참고용. 로컬 개발 시크릿은 .dev.vars 를 사용.
#
# ── 학교 IP 접속 제어 (wrangler.jsonc 의 vars) ──────────────────────
# 학교 IP 범위 "전체"를 승인하는 정책. 학교 공인 대역을 CIDR 로 나열.
#   예) ALLOWED_IPS=203.0.113.0/24,198.51.100.0/24,2001:db8::/32
# 비워두면 IP 검사 없이 전부 통과(개발 상태). 값을 넣으면 자동 enforce.
ALLOWED_IPS=
IP_CHECK_DISABLED=false
#
# ── 세션 (secret 으로 등록) ─────────────────────────────────────────
#   wrangler secret put SESSION_SECRET
SESSION_SECRET=change-me-to-a-long-random-value
#
# ── 관리자 가입 코드 (secret 으로 등록) ─────────────────────────────
# 회원가입 시 이 코드를 입력하면 관리자로 생성된다(단 하나만).
# 공개 저장소 노출 방지를 위해 소스가 아니라 secret 으로 관리.
#   wrangler secret put ADMIN_SIGNUP_CODE
ADMIN_SIGNUP_CODE=00011110000
